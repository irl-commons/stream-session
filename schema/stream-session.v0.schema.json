                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "crew"
              }
            }
          },
          "then": {
            "properties": {
              "feeds": {
                "items": {
                  "$ref": "#/$defs/feed_crew"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "production"
              }
            }
          },
          "then": {
            "properties": {
              "feeds": {
                "items": {
                  "$ref": "#/$defs/feed_production"
                }
              }
            }
          }
        }
      ],
